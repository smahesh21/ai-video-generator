{
  "name": "drishvo-video-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "tsx src/cli.ts",
    "test": "tsx --test tests/pipeline.test.ts tests/studio-approvals.test.ts tests/private-media.test.ts tests/durable-renders.test.ts tests/account-worker-health.test.ts tests/worker-operations.test.ts tests/worker-run-cleanup.test.ts tests/worker-alerts.test.ts tests/render-capacity.test.ts tests/live-storyboard.test.ts tests/instagram.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:queue-recovery": "tsx tests/queue-recovery.integration.ts",
    "test:instagram-publishing": "tsx tests/instagram-publishing.integration.ts",
    "review": "tsx src/review-server.ts",
    "dev": "npm --prefix apps/studio run dev",
    "worker:account": "tsx src/account-queue-worker.ts",
    "worker:instagram": "tsx src/instagram-publish-worker.ts",
    "worker:check": "tsx scripts/check-worker-operations.ts",
    "worker:alert": "tsx scripts/notify-worker-operations.ts",
    "worker:verify-hosted": "tsx scripts/verify-hosted-worker.ts",
    "worker:benchmark-hosted": "tsx scripts/benchmark-hosted-worker.ts",
    "build:studio": "npm --prefix apps/studio run build",
    "typecheck:studio": "npm --prefix apps/studio run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@fontsource/inter": "5.2.8",
    "@remotion/bundler": "4.0.409",
    "@remotion/renderer": "4.0.409",
    "dotenv": "16.6.1",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.409",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
