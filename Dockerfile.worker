FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates ffmpeg fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV FFMPEG_BIN=/usr/bin/ffmpeg
COPY package.json package-lock.json ./
COPY apps/studio/package.json apps/studio/package-lock.json ./apps/studio/
RUN npm ci --no-audit --no-fund --loglevel=info --fetch-timeout=900000 --fetch-retries=5 \
    && npm --prefix apps/studio ci --no-audit --no-fund --loglevel=info --fetch-timeout=900000 --fetch-retries=5

COPY src ./src
COPY scripts/check-worker-operations.ts ./scripts/check-worker-operations.ts
COPY apps/studio/lib ./apps/studio/lib
COPY tsconfig.json ./
RUN mkdir -p runs .cache node_modules/.cache && chown -R node:node runs .cache node_modules/.cache

ENV NODE_ENV=production \
    BROWSER_EXECUTABLE=/usr/bin/chromium \
    WORKER_HEALTH_PORT=8080
EXPOSE 8080
USER node
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=2 \
  CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["./node_modules/.bin/tsx", "src/account-queue-worker.ts"]
