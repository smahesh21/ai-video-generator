# Use accounts after MongoDB, auth secret, and approved emails are configured.
DRISHVO_AUTH_MODE=local
MONGODB_URI=
MONGODB_DB_NAME=aivideogenerator
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
DRISHVO_APPROVED_EMAILS=

# Optional private R2 bucket for new account-owned renders.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional HTTP readiness endpoint for the separate render worker.
# Container deployments set this to 8080; leave empty for local development.
WORKER_HEALTH_PORT=
# Optional Remotion tab concurrency. Keep this at or below available vCPUs.
# Defaults to 2, matching the development e2-medium worker.
RENDER_CONCURRENCY=
# Optional external operations alerts for `npm run worker:alert`.
# URLs must use HTTPS. The webhook receives problem/recovery transitions and six-hour reminders.
# The heartbeat receives successful checks; an external dead-man monitor can alert when they stop.
WORKER_ALERT_WEBHOOK_URL=
WORKER_HEARTBEAT_URL=
# Optional Google Cloud Logging destination for aggregate problem/recovery events.
# On a Compute Engine VM this uses the attached service identity; no API key is stored here.
WORKER_ALERT_GOOGLE_CLOUD_LOG_ID=
# Optional live storyboard generation. Keep provider keys only in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional live narration. These IDs are free-plan premade test voices:
# Alice (female, British educator) and Daniel (male, British broadcaster).
# Indian English library voices require paid ElevenLabs API access.
# Enable only when the web app and render worker both have the settings below.
# Live jobs may consume provider quota and never retry automatically after worker loss.
DRISHVO_LIVE_NARRATION=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_VOICE_ID_INDIAN_MALE=onwK4e9ZLuTAKqWW03F9

# Optional Instagram professional-account connection. Keep disabled until a Meta app
# has the exact callback below and the required Instagram Login permissions.
DRISHVO_INSTAGRAM_ENABLED=false
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# 32 random bytes encoded as base64. Generate a separate value per environment.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Provider URLs/scopes are configurable so a reviewed Meta API version can be pinned.
META_INSTAGRAM_AUTHORIZATION_URL=https://www.instagram.com/oauth/authorize
META_INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
META_INSTAGRAM_GRAPH_URL=https://graph.instagram.com
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
