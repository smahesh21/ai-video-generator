[Unit]
Description=Check Drishvo render worker and deliver aggregate alerts
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/drishvo/app
Environment=DRISHVO_WORKER_ENV_FILE=/etc/drishvo/worker.env
ExecStart=/usr/bin/docker compose -f compose.worker.yaml run --rm --no-deps worker ./node_modules/.bin/tsx scripts/notify-worker-operations.ts
