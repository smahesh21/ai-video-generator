# Copy this file to .env.local and fill in your credentials there.
# Never commit .env.local or actual credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_MALE=
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=
# Optional local Chromium-compatible browser executable path.
BROWSER_EXECUTABLE=
# Optional Remotion tab concurrency. Keep this at or below available vCPUs.
# Defaults to 2, matching the development e2-medium worker.
RENDER_CONCURRENCY=
